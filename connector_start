curl -X POST http://localhost:8083/connectors -H "Content-Type: application/json" -d '{
  "name": "neo4j-sink-productshown",
  "config": {
    "connector.class": "org.neo4j.connectors.kafka.sink.Neo4jConnector",
    "topics": "order_shown",
    "consumer.auto.offset.reset": "earliest",
    "neo4j.uri": "bolt://neo4j:7687",
    "neo4j.authentication.basic.username": "neo4j",
    "neo4j.authentication.basic.password": "password",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "orders-dlq",
    "neo4j.cypher.topic.order_shown": "MERGE (u:User {ext_id: toInteger(event.id1)}) SET u.type = 1 MERGE (pr:Product {ext_id: toInteger(event.id2)}) SET pr.type = 2 MERGE (u)-[r:SHOWN]->(pr) SET r.type = 0, r.name = \"SHOWN\", r.date = datetime(replace(substring(event.time_str, 0, 19), \" \", \"T\"))"
  }
}'

